{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alliance-tracker",
  "main": "./src/scoring-entry-v152.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alliance-tracker-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "vars": {
    "APP_NAME": "Alliance Tracker",
    "PRIMARY_ALLIANCE_ABBR": "WDZ",
    "DUEL_CYCLE_ANCHOR": "2026-08-02"
  },
  "observability": {
    "enabled": true
  }
}
